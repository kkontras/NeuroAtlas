*.docx

# EEG benchmark large local assets
src/extensions/datasets/dataio/SHHS/assets/*.pkl
src/extensions/datasets/dataio/SHHS/assets/*.mat

# Legacy local dataset artifacts
src/synib/mydatasets/CREMAD/*.json
src/synib/mydatasets/CREMAD/*.pkl
